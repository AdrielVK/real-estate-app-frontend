# Server-only Google Places API (New) key used by the geocoding proxy
# routes (/api/geocoding/autocomplete and /api/geocoding/details).
# Read ONLY in src/lib/geocoding/places-api.ts. Never prefix with
# NEXT_PUBLIC_ — the key must stay out of the browser bundle (GP-7).
GOOGLE_PLACES_API_KEY=

# Public Mapbox access token for the admin address pin (AS-16). Unlike
# the Places key above, this one is INTENTIONALLY exposed to the browser
# via the NEXT_PUBLIC_ prefix — Mapbox GL JS loads tiles client-side.
# Create a token at https://account.mapbox.com/access-tokens/ and
# restrict it to your deployed domains (URL restriction) + the
# `styles:read` scope only. The build and the whole test suite pass
# WITHOUT this variable: AddressMap renders a muted fallback copy
# instead of a map (AS-17), so CI and tokenless contributors are safe.
NEXT_PUBLIC_MAPBOX_TOKEN=
